generator client {
  provider               = "prisma-client-js"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  NURSE
  DOCTOR
  LAB_TECHNICIAN
  PATIENT
  CASHIER
}

enum Status {
  ACTIVE
  INACTIVE
  DORMANT
}

enum JOBTYPE {
  FULL
  PART
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum AppointmentStatus {
  PENDING
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CASH
  CARD
}

enum PaymentStatus {
  PAID
  UNPAID
  PART
}

model Patient {
  id                       String   @id
  first_name               String   @db.VarChar(50)
  last_name                String   @db.VarChar(50)
  date_of_birth            DateTime
  gender                   Gender   @default(MALE)
  phone                    String   @db.VarChar(20)
  email                    String   @unique @db.VarChar(100)
  marital_status           String
  address                  String
  emergency_contact_name   String
  emergency_contact_number String   @db.VarChar(20)
  relation                 String?
  blood_group              String?
  allergies                String?
  medical_conditions       String?
  medical_history          String?
  insurance_provider       String?
  insurance_number         String?
  privacy_consent          Boolean
  service_consent          Boolean
  medical_consent          Boolean
  img                      String?
  colorCode                String?
  is_deleted               Boolean?  @default(false)
  created_by               String?
  updated_by               String?

  appointments             Appointment[]
  medicalRecords           MedicalRecords[]
  payments                 Payment[]
  ratings                  Rating[]
  growthMeasurements       GrowthMeasurement[]
  immunizations            ImmunizationRecord[]
  developmentalMilestones DevelopmentalMilestone[]

  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt
}

model Doctor {
  id                    String   @id
  email                 String   @unique @db.VarChar(100)
  name                  String
  specialization        String
  license_number        String
  phone                 String
  address               String
  department            String?
  img                   String?
  colorCode             String?
  availability_status   String?
  type                  JOBTYPE  @default(FULL)
  is_deleted            Boolean  @default(false)
  created_by            String?
  updated_by            String?

  working_days          WorkingDays[]
  appointments          Appointment[]
  ratings               Rating[]
  diagnosis             Diagnosis[]

  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
}

model WorkingDays {
  id         Int    @id @default(autoincrement())
  doctor_id  String
  day        String
  start_time String
  close_time String
  created_by String?
  updated_by String?

  doctor     Doctor @relation(fields: [doctor_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Staff {
  id             String   @id
  email          String   @unique @db.VarChar(100)
  name           String
  phone          String
  address        String
  department     String?
  img            String?
  license_number String?
  colorCode      String?
  role           Role
  status         Status @default(ACTIVE)
  is_deleted     Boolean @default(false)
  created_by     String?
  updated_by     String?

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model Appointment {
  id               Int    @id @default(autoincrement())
  patient_id       String
  doctor_id        String
  appointment_date DateTime
  time             String
  status           AppointmentStatus @default(PENDING)
  type             String
  note             String?
  reason           String?
  created_by       String?
  updated_by       String?

  patient          Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor           Doctor  @relation(fields: [doctor_id], references: [id], onDelete: Cascade)

  payments         Payment[]
  medicalRecords   MedicalRecords[]

  @@index([patient_id])
  @@index([doctor_id])

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model Payment {
  id              Int    @id @default(autoincrement())
  patient_id      String
  appointment_id  Int
  bill_date       DateTime
  payment_date    DateTime
  discount        Float
  total_amount    Float
  amount_paid     Float
  payment_method  PaymentMethod @default(CASH)
  status          PaymentStatus @default(UNPAID)
  receipt_number  Int @default(autoincrement())
  created_by      String?
  updated_by      String?

  appointment     Appointment @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  patient         Patient     @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  patientBills    PatientBills[]

  @@index([patient_id])
  @@index([status])

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model PatientBills {
  id           Int      @id @default(autoincrement())
  bill_id      Int
  service_id   Int
  service_date DateTime
  quantity     Int
  unit_cost    Float
  total_cost   Float
  created_by   String?
  updated_by   String?

  service      Services @relation(fields: [service_id], references: [id])
  payment      Payment  @relation(fields: [bill_id], references: [id], onDelete: Cascade)

  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model LabTest {
  id             Int    @id @default(autoincrement())
  record_id      Int
  test_date      DateTime
  result         String
  status         String
  notes          String?
  service_id     Int
  created_by     String?
  updated_by     String?

  medical_record MedicalRecords @relation(fields: [record_id], references: [id], onDelete: Cascade)

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  Services Services[] @relation(name: "LabTestToServices")
}

model MedicalRecords {
  id                   Int    @id @default(autoincrement())
  patient_id           String
  appointment_id       Int
  doctor_id            String
  treatment_plan       String?
  prescriptions        String?
  lab_request          String?
  notes                String?
  created_by           String?
  updated_by           String?

  appointment          Appointment  @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  patient              Patient      @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  lab_test             LabTest[]
  vital_signs          VitalSigns[]
  diagnosis            Diagnosis[]

  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
}

model VitalSigns {
  id                Int    @id @default(autoincrement())
  patient_id        String
  medical_id        Int
  taken_at          DateTime
  body_temperature  Float
  systolic          Int
  diastolic         Int
  heartRate         Int
  respiratory_rate  Int?
  oxygen_saturation Int?
  weight            Float
  height            Float
  created_by        String?
  updated_by        String?

  medical           MedicalRecords @relation(fields: [medical_id], references: [id], onDelete: Cascade)

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model Diagnosis {
  id                    Int    @id @default(autoincrement())
  patient_id            String
  medical_id            Int
  doctor_id             String
  symptoms              String
  diagnosis             String
  notes                 String?
  prescribed_medications String?
  follow_up_plan        String?
  created_by            String?
  updated_by            String?

  doctor                Doctor         @relation(fields: [doctor_id], references: [id])
  medical               MedicalRecords @relation(fields: [medical_id], references: [id], onDelete: Cascade)

  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
}

model AuditLog {
  id          Int     @id @default(autoincrement())
  user_id     String
  model_type  String
  model_id    String
  action      String
  details     String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Rating {
  id         Int     @id @default(autoincrement())
  staff_id   String
  patient_id String
  rating     Int
  comment    String?
  created_by String?
  updated_by String?

  doctor     Doctor  @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  patient    Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Services {
  id            Int     @id @default(autoincrement())
  service_name  String
  description   String
  price         Float
  created_by    String?
  updated_by    String?

    labtest LabTest? @relation(name: "LabTestToServices", fields: [labtestid], references: [id])
labtestid Int?
  patientBills  PatientBills[]

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model GrowthMeasurement {
  id             Int     @id @default(autoincrement())
  patient_id     String
  date           DateTime
  height         Float
  weight         Float
  head_circumference Float
  notes          String?
  created_by     String?
  updated_by     String?

  patient        Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model ImmunizationRecord {
  id             Int     @id @default(autoincrement())
  patient_id     String
  vaccine_name   String
  date_administered DateTime
  administered_by String?
  notes          String?
  created_by     String?
  updated_by     String?

  patient        Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model DevelopmentalMilestone {
  id             Int     @id @default(autoincrement())
  patient_id     String
  milestone      String
  age_achieved   String
  date_recorded  DateTime
  notes          String?
  created_by     String?
  updated_by     String?

  patient        Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}
